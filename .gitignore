# ========================
# Node Modules (NEVER upload)
# ========================
node_modules/
frontend/node_modules/
backend/node_modules/

# ========================
# Environment Files (SECRET - NEVER upload)
# ========================
.env
.env.local
.env.development
.env.production
backend/.env
frontend/.env

# ========================
# Build Output
# ========================
frontend/build/
build/

# ========================
# Logs
# ========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ========================
# MacOS System Files
# ========================
.DS_Store
**/.DS_Store

# ========================
# Editor / IDE Configs
# ========================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ========================
# Cache
# ========================
.cache/
backend/.cache/
frontend/.cache/
.eslintcache

# ========================
# Temporary Files
# ========================
*.swp
*.tmp
*.bak

# ========================
# Test Coverage Reports
# ========================
coverage/
frontend/coverage/
backend/coverage/

# ========================
# Upload folder (optional: remove if you want uploads tracked)
# ========================
backend/uploads/*
!backend/uploads/.gitkeep
